# Eventbrite API Configuration
EVENTBRITE_API_KEY=your_eventbrite_api_key_here
EVENTBRITE_ORGANIZATION_ID=your_eventbrite_organization_id_here 

# Resend — contact form delivery and newsletter sign-up.
# Without these the contact form refuses to send and the newsletter sign-up
# renders disabled with a "Coming soon" note.
RESEND_API_KEY=your_resend_api_key_here
# The sender address. Defaults to ncmametromd@gmail.com when unset.
# Resend only sends from a domain verified in the account, so a gmail.com
# sender is rejected: point this at the verified domain to send for real.
CONTACT_FROM_EMAIL=ncmametromd@gmail.com

# Newsletter audience. Set RESEND_AUDIENCE_ID for one combined list, or the
# per-segment ids below to keep the "I am" answer (Resend contacts have no
# custom fields, so a separate audience is the only way to keep it).
RESEND_AUDIENCE_ID=your_resend_audience_id_here
# RESEND_AUDIENCE_ID_GOVERNMENT=
# RESEND_AUDIENCE_ID_INDUSTRY=
# RESEND_AUDIENCE_ID_STUDENT=
